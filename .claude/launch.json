{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "dev-webpack",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--webpack"],
      "port": 3000
    },
    {
      "name": "dev-webpack-3100",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--webpack", "--port", "3100"],
      "port": 3100
    },
    {
      "name": "prod-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "port": 3000
    },
    {
      "name": "prod-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start", "--", "-p", "3001"],
      "port": 3001
    },
    {
      "name": "design-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8123"],
      "port": 8123
    }
  ]
}
