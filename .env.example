# Copy this file to .env and fill in your own values.
# Placeholders only. Never commit real credentials.

# Pooled connection, used by the app at runtime through the Prisma driver
# adapter (Supabase: transaction pooler, port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Unpooled connection, used by the Prisma CLI for migrations (Supabase: session
# pooler, port 5432). Read by prisma.config.ts, not by schema.prisma. Can point
# at the same database as DATABASE_URL. Every Prisma CLI command fails without it.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase dashboard, Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"

# Supabase dashboard, Settings > API > Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"

# Anthropic API key, used for Orbit's extraction and chat copy
ANTHROPIC_API_KEY="sk-ant-YOUR_KEY"

# Shared secret for the daily scheduled job. Only needed if you run the cron
# route. Any long random string.
CRON_SECRET="YOUR_RANDOM_SECRET"

# Resend API key, used for group digest mail (src/lib/email/send.ts). Login
# codes do NOT come through it: those leave through Supabase Auth on the
# account. subdomain. Without this key, a send returns service_error.
RESEND_API_KEY="re_YOUR_KEY"

# Who may be mailed from a non-production environment. Comma separated, and
# matched case-insensitively. Leaving it unset means nothing sends locally at
# all, which is the intended default rather than a bug: the dev-test database
# holds QA rows carrying real addresses, so this fails closed on purpose and a
# local run cannot mail a real person from a half-built feature. A send that is
# refused this way returns suppressed_dev, which is a success and not an error.
# Put your own address here to receive a test send from `npm run email:test`.
EMAIL_DEV_ALLOWLIST="you@example.com"
